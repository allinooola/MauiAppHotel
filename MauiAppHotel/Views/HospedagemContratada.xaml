<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand">

        <Label 
            Text="Suíte Super Luxo"
            TextColor="{StaticResource Primary}"
            FontSize="50"
            FontFamily="Kalam"
            HorizontalOptions="Center" />

        <Label 
            Text="Sua hospedagem foi contratada com sucesso!"
            FontSize="18"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center" />

        <Frame 
            Margin="10">
            <HorizontalStackLayout>

            <HorizontalStackLayout>
                <Label Text="Adultos:  " />
                <Label Text=" 2"
                       TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>
                <Label Text="  Crianças:  " />
                <Label Text=" 2"
                       TextColor="{StaticResource Primary}" />
            </HorizontalStackLayout>
        </Frame>

        <Frame
            Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto, Auto">
                <Label Grid.Row="0" Grid.Column="0" Text="Check-in: " />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out: " />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia: " />

                <Label Grid.Row="1" Grid.Column="0" Text="27/06/2024" />
                <Label Grid.Row="1" Grid.Column="1" Text="30/06/2024" />
                <Label Grid.Row="1" Grid.Column="2" Text="3 dias" />
            </Grid>
        </Frame>

        <Frame 
            Margin="10">
            <HorizontalStackLayout>
                <Label Text="Valor Total: " />
                <Label Text=" R$750,00"/>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar" 
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />
        
    </VerticalStackLayout>

</ContentPage>